[Unit]
Description=Swangz AI Hub restore check (the newest backup is recent, intact and opens as a gateway database)
After=swangz-gateway-backup.service

[Service]
Type=oneshot
User=swangz
WorkingDirectory=/opt/swangz-gateway
# Reads only the backups folder; the scratch copy is written beside the backup and removed. Never the live database.
ExecStart=/usr/bin/python3 -m gateway backup-verify --latest
Nice=10
IOSchedulingClass=idle
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/swangz-gateway/data
PrivateTmp=true
# Hardening (security review, Nov 14, 2026): no capabilities, no device nodes, no other users' homes, only the
# socket kinds it uses (kept the same as the backup unit).
ProtectHome=true
PrivateDevices=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
