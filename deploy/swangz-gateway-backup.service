[Unit]
Description=Swangz AI Hub database backup (verified copy, optionally sent off the server)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=swangz
WorkingDirectory=/opt/swangz-gateway
# reads .env itself, like the gateway: GATEWAY_BACKUP_REMOTE / _KEEP / _DIR / _SSH / _SSH_PORT
ExecStart=/usr/bin/python3 -m gateway backup
Nice=10
IOSchedulingClass=idle
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/swangz-gateway/data
PrivateTmp=true
# Hardening (security review, Nov 14, 2026): no capabilities, no device nodes, no other users' homes, only the
# socket kinds it uses (ssh and rsync to the off-server copy need AF_INET/AF_INET6).
ProtectHome=true
PrivateDevices=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
