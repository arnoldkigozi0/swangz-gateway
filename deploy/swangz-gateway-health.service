[Unit]
Description=Swangz AI Hub uptime check (the gateway answers /healthz with "ok": true)
After=swangz-gateway.service

[Service]
Type=oneshot
User=swangz
WorkingDirectory=/opt/swangz-gateway
# The command reads /opt/swangz-gateway/.env itself, as the gateway does, and uses only GATEWAY_HOST / GATEWAY_PORT to
# find the local address. It asks /healthz and reports; it opens no database, writes nothing and never touches the
# gateway service itself.
ExecStart=/usr/bin/python3 -m gateway health-check
Nice=10
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
