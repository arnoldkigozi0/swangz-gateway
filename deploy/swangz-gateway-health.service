[Unit]
Description=Swangz AI Hub uptime check (the gateway answers /healthz with "ok": true)
After=swangz-gateway.service

[Service]
Type=oneshot
User=swangz
WorkingDirectory=/opt/swangz-gateway
# Only GATEWAY_HOST / GATEWAY_PORT are read, to find the local address. It asks /healthz and reports; it opens no
# database, writes nothing and never touches the gateway service itself.
EnvironmentFile=-/opt/swangz-gateway/.env
ExecStart=/usr/bin/python3 -m gateway health-check
Nice=10
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
PrivateTmp=true
