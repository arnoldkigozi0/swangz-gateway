[Unit]
Description=Swangz AI Gateway
After=network-online.target
Wants=network-online.target

[Service]
User=swangz
WorkingDirectory=/opt/swangz-gateway
# the gateway reads /opt/swangz-gateway/.env itself (one parser for every setting, comments allowed)
ExecStart=/usr/bin/python3 -m gateway serve
Restart=always
RestartSec=3
# the gateway needs nothing but its own folder
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/swangz-gateway/data
PrivateTmp=true

[Install]
WantedBy=multi-user.target
