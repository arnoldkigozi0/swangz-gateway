# Swangz AI Gateway — copy to .env and fill in. NEVER commit the real .env (it is in .gitignore).
#
#   cp .env.example .env && nano .env
#
# Everything here is read at start-up only, so restart the gateway after changing it.

# ---------------------------------------------------------------- where it runs
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8787
GATEWAY_DATA=data                 # the folder holding gateway.db — back this up, it IS the record

# The address staff type into their tools. Leave empty and it is read from each request, which is
# right behind a tunnel whose name changes. Set it once you have a real one, e.g. https://ai.swangzavenue.com
GATEWAY_PUBLIC_URL=

# The address people OPEN THE APPS at, when that differs from the gateway's own — e.g. the Netlify
# front door that proxies through to here. Sign-in links and Google's return address use it.
GATEWAY_WEB_URL=https://swangz-ai.netlify.app

# Behind a proxy, a tunnel or Netlify: trust the forwarded headers, and treat requests as https.
GATEWAY_TRUST_PROXY=1
GATEWAY_FORCE_HTTPS=1

# Only needed if the front-end calls the gateway across origins instead of through the front door.
GATEWAY_CORS_ORIGINS=https://swangz-ai.netlify.app

GATEWAY_TZ_OFFSET=+03:00          # budget days and months follow Kampala time

# ---------------------------------------------------------------- the first owner
# Used only when there is no console user yet. Delete both lines once the account exists.
GATEWAY_BOOTSTRAP_ADMIN=arnoldkigozi0@gmail.com
GATEWAY_BOOTSTRAP_PASSWORD=

# ---------------------------------------------------------------- sign in with Google
# From console.cloud.google.com → APIs & Services → Clients → Web application.
# The redirect URI registered there must be exactly  <GATEWAY_WEB_URL>/auth/google/callback
# Leave both empty and the "Continue with Google" button simply does not appear.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------- company provider keys
# These are the company's own keys. Staff never see them: they hold a gateway key and the gateway
# swaps it for one of these on the way out. Leave a line empty and that provider is simply off.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
HIGGSFIELD_CREDENTIALS=           # KEY_ID:KEY_SECRET

# ---------------------------------------------------------------- odds and ends
# GATEWAY_PROVIDERS=/path/providers.json   # extra or stand-in providers (the laptop demo uses this)
# GATEWAY_FETCH_ICONS=0                    # stop fetching tool logos from the internet
# GATEWAY_TLS_CERT= / GATEWAY_TLS_KEY=     # only if the gateway terminates https itself (Caddy is easier)
