# Provider keys — only the server ever sees these
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# The address staff use (https turns on secure cookies)
GATEWAY_PUBLIC_URL=https://ai.example.com
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8787
GATEWAY_DATA=data
GATEWAY_TZ_OFFSET=+03:00
# behind Caddy/nginx/a tunnel, take client IPs from X-Forwarded-For
GATEWAY_TRUST_PROXY=1

# Optional: create the first owner on hosts without a shell
# GATEWAY_BOOTSTRAP_ADMIN=
# GATEWAY_BOOTSTRAP_PASSWORD=
